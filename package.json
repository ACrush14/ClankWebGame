{
  "name": "clank-web-game",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "engine"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "test:engine": "npm run test --workspace engine"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
